rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.uid == "y0vz40TxTze8W225zMK7As8o4Uz2"
      );
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isBoundedMap(data, maxKeys) {
      return data is map && data.keys().size() <= maxKeys;
    }

    function isValidFavorites(favs) {
      return favs is map
        && favs.keys().hasOnly(['song', 'album', 'member'])
        && (!('song' in favs) || (favs.song is list && favs.song.size() <= 300))
        && (!('album' in favs) || (favs.album is list && favs.album.size() <= 100))
        && (!('member' in favs) || (favs.member is list && favs.member.size() <= 20));
    }

    function isValidSettings(s) {
      return s is map
        && s.keys().hasOnly(['autoplay', 'rememberPlayback', 'trackRecentlyPlayed'])
        && (!('autoplay' in s) || s.autoplay is bool)
        && (!('rememberPlayback' in s) || s.rememberPlayback is bool)
        && (!('trackRecentlyPlayed' in s) || s.trackRecentlyPlayed is bool);
    }

    function isValidUserDoc(data) {
      return data is map
        && data.keys().hasOnly(['favorites', 'theme', 'settings', 'recentlyPlayed', 'updatedAt'])
        && (!('theme' in data) || (data.theme is string && data.theme.size() <= 40))
        && (!('recentlyPlayed' in data) || (data.recentlyPlayed is list && data.recentlyPlayed.size() <= 20))
        && (!('favorites' in data) || isValidFavorites(data.favorites))
        && (!('settings' in data) || isValidSettings(data.settings))
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    match /albums/{albumId} {
      allow read: if true;
      allow delete: if isAdmin();
      allow create, update: if isAdmin() && isBoundedMap(request.resource.data, 20);
    }

    match /tracks/{trackId} {
      allow read: if true;
      allow delete: if isAdmin();
      allow create, update: if isAdmin() && isBoundedMap(request.resource.data, 25);
    }

    match /news/{newsId} {
      allow read: if true;
      allow delete: if isAdmin();
      allow create, update: if isAdmin() && isBoundedMap(request.resource.data, 20);
    }

    match /members/{id} {
      allow read: if true;
      allow delete: if isAdmin();
      allow create, update: if isAdmin() && isBoundedMap(request.resource.data, 25);
    }

    match /config/{docId} {
      allow read: if true;
      allow delete: if isAdmin();
      allow create, update: if isAdmin() && isBoundedMap(request.resource.data, 15);
    }

    match /users/{userId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidUserDoc(request.resource.data);
    }

    // Explicit default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
