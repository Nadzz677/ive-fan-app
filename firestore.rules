rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.uid == "y0vz40TxTze8W225zMK7As8o4Uz2";
    }

    match /albums/{albumId}  { allow read: if true; allow write: if isAdmin(); }
    match /tracks/{trackId}  { allow read: if true; allow write: if isAdmin(); }
    match /news/{newsId}     { allow read: if true; allow write: if isAdmin(); }
    match /members/{id}      { allow read: if true; allow write: if isAdmin(); }
    match /config/{docId}    { allow read: if true; allow write: if isAdmin(); }

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
